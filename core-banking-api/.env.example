# Local demo works without an API key or model download.
AI_MODE=demo

# Free AI option: get a key from a Gemini Free Tier project with billing disabled.
# Set AI_MODE=gemini once the key is saved, then restart.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional paid provider, not required. Set AI_MODE=openai only if desired.
# Keep .env private. Never put keys in frontend code or Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local FAQ index. Contains fictional policies only, never customer/KYC documents.
CHROMA_DIR=.data/chroma

# SQLite at project/banking.db by default. Set a persistent path when hosted.
# DATABASE_URL=sqlite:////data/banking.db
# Public deployments require HTTPS and secure cookies.
DEMO_MODE=true
COOKIE_SECURE=false
